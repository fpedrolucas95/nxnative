# MacBook Air M4 / 16 GB, v131072. Recovered from the Nov. 5, 2026 playtests.
# Scale, MetalFX and encode thread were active when performance improved.
DM_RENDER_SCALE=0.5
DM_UPSCALER=metalfx
DM_NVN_ENC_THREAD=1
# Heap 0 removed the DOF blocks. This is a visual workaround, not a memory fix:
# that run subsequently reached the residency limit. Keep the guard enabled.
DM_NVN_POOL_HEAP=0
# Tile-pass inference on: measured 5 November on the chain 72458830f2f7 build, same save and route, frames 1500-1800 against the preset alone —
# frame p50 26.6 ms and GPU p50 35.1 ms against 69.9 / 85.3 ms, with the frame-1600 screenshot checked (foliage and terrain as before; the pond
# surface above is missing either way). Attachments were about 330 MB a frame loaded and stored without it. Resident memory is no lower (12.2 GB),
# so the residency guard below still ends long sessions; DM_NVN_TBDR=0 is the old path.
DM_NVN_TBDR=1
DM_NVN_RES_LIMIT_MB=11300
# Restore the normal defaults, not the unsuccessful memory experiments.
DM_NVN_GMEM_RES=1
DM_NVN_TEX_MIP_SKIP=0
DM_OPMODE=1
DM_LANG=en-US
DM_WINDOW=1
DM_AUDIO=1
DM_FOCUS_KEEP=1
DM_METAL_HUD=1
